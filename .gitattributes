# Preserve byte-identity with the live kotiva-stg deploy.
# All text served as-authored with LF endings (matches live nginx-served bytes).
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.svg  text eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
